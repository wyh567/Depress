# Copy only the relevant section into each root-owned /etc/depress/*.env file.
# Replace angle-bracket placeholders outside the repository. Never commit values.

# /etc/depress/web.env (owner root:depress-web, mode 0640)
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
NEXT_TELEMETRY_DISABLED=1
DEPRESS_API_ORIGIN=http://127.0.0.1:3001

# /etc/depress/api.env (owner root:depress-api, mode 0640)
NODE_ENV=production
LOG_LEVEL=info
API_BIND_HOST=127.0.0.1
API_PORT=3001
API_BODY_LIMIT_BYTES=1048576
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
DOI_RATE_LIMIT_MAX=10
COMPILE_RATE_LIMIT_MAX=5
COMPILE_ACTIVE_JOB_LIMIT=2
COMPILE_SNAPSHOT_MAX_BYTES=2097152
PUBLIC_ORIGIN=https://<public-web-origin>
AUTH_ORIGIN=https://<public-web-origin>
BETTER_AUTH_SECRET=<random-secret-at-least-32-characters>
# PostgreSQL role: depress_api (not the Linux identity depress-api)
DATABASE_URL=<postgresql-depress-api-role-connection-url>
REDIS_URL=<private-redis-url>
# false = virtual-hosted-style (required by Alibaba OSS S3-compatible endpoints);
# true = path-style (useful for providers such as local MinIO). With a custom
# endpoint, the application defaults to true when this setting is omitted.
S3_ENDPOINT=<private-s3-compatible-origin>
S3_FORCE_PATH_STYLE=false
S3_REGION=<s3-region>
S3_BUCKET=<private-artifact-bucket>
S3_ACCESS_KEY_ID=<api-read-access-key-id>
S3_SECRET_ACCESS_KEY=<api-read-secret-access-key>
CROSSREF_MAILTO=<operator-contact-email>

# /etc/depress/outbox.env (owner root:depress-outbox, mode 0640)
NODE_ENV=production
LOG_LEVEL=info
# PostgreSQL role: depress_outbox (not the Linux identity depress-outbox)
DATABASE_URL=<postgresql-depress-outbox-role-connection-url>
REDIS_URL=<private-redis-url>
OUTBOX_BATCH_SIZE=25
OUTBOX_POLL_INTERVAL_MS=1000

# /etc/depress/pointer-worker.env (owner root:depress-worker, mode 0640)
NODE_ENV=production
LOG_LEVEL=info
# PostgreSQL role: depress_pointer_worker (not the Linux identity depress-worker)
DATABASE_URL=<postgresql-depress-pointer-worker-role-connection-url>
REDIS_URL=<private-redis-url>
S3_ENDPOINT=<private-s3-compatible-origin>
S3_FORCE_PATH_STYLE=false
S3_REGION=<s3-region>
S3_BUCKET=<private-artifact-bucket>
S3_ACCESS_KEY_ID=<worker-write-access-key-id>
S3_SECRET_ACCESS_KEY=<worker-write-secret-access-key>
POINTER_WORKER_CONCURRENCY=1
TYPST_IMAGE=<must-match-code-owned-pinned-digest>
TYPST_FONT_PATH=<absolute-host-font-directory>

# /etc/depress/migration.env (owner root:depress-migration, mode 0640)
# PostgreSQL role: depress_migration (not the Linux identity depress-migration)
DATABASE_URL=<postgresql-depress-migration-role-connection-url>

# /etc/depress/artifact-cleanup.env (owner root:depress-cleanup, mode 0640)
# PostgreSQL role: depress_cleanup (not the Linux identity depress-cleanup)
DATABASE_URL=<postgresql-depress-cleanup-role-connection-url>
S3_ENDPOINT=<private-s3-compatible-origin>
S3_FORCE_PATH_STYLE=false
S3_REGION=<s3-region>
S3_BUCKET=<private-artifact-bucket>
S3_ACCESS_KEY_ID=<cleanup-delete-access-key-id>
S3_SECRET_ACCESS_KEY=<cleanup-delete-secret-access-key>
