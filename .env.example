# Copy to `.env` for local round-trip (API server + worker).
# Infra: `docker compose up -d` (Redis :6379, MinIO :9000, bucket depress-artifacts).

# API / worker runtime
PORT=3001
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://depress:depress-secret@localhost:5432/depress
AUTH_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Invite-only mentor seed; set explicitly only when running auth:seed-mentor.
# MENTOR_EMAIL=
# MENTOR_PASSWORD=
# MENTOR_NAME=

# S3-compatible artifacts (MinIO defaults match docker-compose.yml)
S3_BUCKET=depress-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=depress
S3_SECRET_ACCESS_KEY=depress-secret
S3_ENDPOINT=http://localhost:9000

# Crossref polite pool (optional; not a secret). Recommended in production so
# Crossref can contact operators about API use. Local boot works without it.
# CROSSREF_MAILTO=ops@example.com

# Web API origin for direct API helpers (optional; defaults to http://localhost:3001)
# NEXT_PUBLIC_API_URL=http://localhost:3001
